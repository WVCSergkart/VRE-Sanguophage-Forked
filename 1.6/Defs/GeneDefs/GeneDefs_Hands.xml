				<hediffDefName>VRE_SharpTalons</hediffDefName>
				<bodyparts>
				  <li>Hand</li>
				  <li>Hand</li>
				</bodyparts>
			</li>
		</modExtensions>
	</GeneDef>

	<HediffDef ParentName="WVC_XenotypesAndGenes_Hediffs_VerbWeapon">
		<defName>VRE_SharpTalons</defName>
		<label>sharp talons</label>
		<description>Sharp talons which can be used in melee combat.</description>
		<comps>
			<li Class="HediffCompProperties_VerbGiver">
				<tools>
					<li>
						<label>talons</label>
						<capacities>
							<li>Cut</li>
						</capacities>
						<power>16</power>
						<cooldownTime>2</cooldownTime>
					</li>
				</tools>
			</li>
		</comps>
